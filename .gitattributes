# 줄바꿈은 저장소 안에서 LF로 통일한다.
# (CI가 ubuntu/windows 양쪽에서 돌고, Rust·shell 스크립트가 섞이므로)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 바이너리 — diff/변환 금지
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.woff binary
*.woff2 binary
