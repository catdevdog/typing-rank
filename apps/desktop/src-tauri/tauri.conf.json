{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypingRank",
  "version": "0.1.0",
  "identifier": "dev.typingrank.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "dashboard",
        "title": "TypingRank",
        "width": 720,
        "height": 560,
        "resizable": true,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "TypingRank Overlay",
        "width": 300,
        "height": 200,
        "x": 40,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
